<UserControl x:Class="XboxMetroLauncher.Views.Tabs.HomeTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:XboxMetroLauncher.Views.Tabs;assembly=XboxMetroLauncher">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Button Canvas.Left="-2" Canvas.Top="169" Width="56" Height="56" Visibility="Collapsed" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.OpenSearchCommand}">
        <Grid Background="#FF555A5C">
          <Path Stroke="#FFE9E9E9" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,18 A10,10 0 1 1 32,32M30,30 L40,40" />
        </Grid>
      </Button>
      <Canvas Name="HomeAlignedFrame" Left="220" Top="11" Width="764" Height="368" ClipToBounds="False">
        <Button Canvas.Left="0" Canvas.Top="0" Width="177" Height="122" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.LaunchGameCommand}" CommandParameter="{Binding Shell.TrayGame}">
          <Grid ClipToBounds="True" Background="{Binding Shell.DashboardTileBrush}">
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.OpenTrayCoverArtPath, Converter={StaticResource StringToImageSourceConverter}}" />
            <Rectangle Fill="#00000000" />
            <Ellipse Width="56" Height="56" Fill="#E8FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-14,0,0" />
            <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-14,0,0" Fill="{Binding Shell.DashboardTileBrush}" />
            <TextBlock FontSize="18" Foreground="#FFFFFFFF" Margin="13,0,0,10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.open-tray|Open Tray}" />
          </Grid>
        </Button>
        <Button Canvas.Left="0" Canvas.Top="123" Width="177" Height="122" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.OpenMyPinsCommand}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <Image Stretch="Uniform" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0" Source="{Binding Source=Assets/Misc/pin.png, Converter={StaticResource CropImageSourceConverter}, ConverterParameter=574;274;392;392}" />
            <TextBlock FontSize="17" Foreground="#FFFFFFFF" Margin="12,0,0,12" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.pins|My Pins}" />
          </Grid>
        </Button>
        <Button Canvas.Left="0" Canvas.Top="246" Width="177" Height="122" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.ShowDetailsCommand}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
              <Ellipse Stroke="#E8FFFFFF" StrokeThickness="4" />
              <Path Stroke="#E8FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M18,8 L18,20 L27,20" />
            </Grid>
            <TextBlock FontSize="17" Foreground="#FFFFFFFF" Margin="12,0,0,12" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.recent|Recent}" />
          </Grid>
        </Button>
        <Button Canvas.Left="179" Canvas.Top="0" Width="423" Height="242" Style="{StaticResource X360TileButtonStyle}">
          <Grid ClipToBounds="True">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFBFD5D8" Offset="0" />
                <GradientStop Color="#FF3B5E65" Offset="0.34" />
                <GradientStop Color="#FF111A1D" Offset="0.78" />
                <GradientStop Color="#FF9EAEB0" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.halo|Assets/Tiles/halo4home.jpg|512}" />
            <Rectangle>
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#24000000" Offset="0" />
                  <GradientStop Color="#00000000" Offset="0.48" />
                  <GradientStop Color="#A8000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Rectangle Height="30" VerticalAlignment="Bottom" Fill="#C9000000" />
            <TextBlock FontSize="17" Foreground="#FFFFFFFF" Margin="8,0,0,6" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.halo|Halo 4}" />
          </Grid>
        </Button>
        <Button Canvas.Left="179" Canvas.Top="244" Width="210" Height="124" Style="{StaticResource X360TileButtonStyle}">
          <Grid ClipToBounds="True">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF2D100D" Offset="0" />
                <GradientStop Color="#FFE27522" Offset="0.5" />
                <GradientStop Color="#FF321A16" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.dexter|Assets/Tiles/dexterhome.jpg|320}" />
            <Rectangle>
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#28000000" Offset="0.55" />
                  <GradientStop Color="#B0000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Rectangle Height="30" VerticalAlignment="Bottom" Fill="#C9000000" />
            <TextBlock FontSize="17" Foreground="#FFFFFFFF" Margin="8,0,0,6" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.dexter|Dexter}" />
          </Grid>
        </Button>
        <Button Canvas.Left="391" Canvas.Top="244" Width="211" Height="124" Style="{StaticResource X360TileButtonStyle}">
          <Grid ClipToBounds="True">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFCFCFCF" Offset="0" />
                <GradientStop Color="#FF50606F" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.maroon5|Assets/Tiles/maroon5home.jpg|320}" />
            <Rectangle>
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#30000000" Offset="0.62" />
                  <GradientStop Color="#B0000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Rectangle Height="30" VerticalAlignment="Bottom" Fill="#C9000000" />
            <TextBlock FontSize="17" Foreground="#FFFFFFFF" Margin="8,0,0,6" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.maroon5|Maroon 5}" />
          </Grid>
        </Button>
        <Button Canvas.Left="604" Canvas.Top="0" Width="160" Height="122" Style="{StaticResource X360TileButtonStyle}">
          <Grid ClipToBounds="True">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF171A5C" Offset="0" />
                <GradientStop Color="#FF9333C4" Offset="0.5" />
                <GradientStop Color="#FF10103A" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.kinect|Assets/Tiles/dancecentralhome.jpg|256}" />
            <Rectangle>
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#24000000" Offset="0.58" />
                  <GradientStop Color="#B0000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Rectangle Height="30" VerticalAlignment="Bottom" Fill="#C9000000" />
            <TextBlock FontSize="16" Foreground="#FFFFFFFF" Margin="8,0,0,6" VerticalAlignment="Bottom" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.kinect|Kinect Central}" />
          </Grid>
        </Button>
        <Button Canvas.Left="604" Canvas.Top="123" Width="160" Height="122" Style="{StaticResource X360TileButtonStyle}">
          <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="91" />
              <RowDefinition Height="31" />
            </Grid.RowDefinitions>
            <Image Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.sports|Assets/Tiles/espn.jpg|256}" />
            <Rectangle Grid.RowSpan="2">
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#10000000" Offset="0.58" />
                  <GradientStop Color="#B0000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Border Grid.Row="1" Background="#FF6F1414">
              <TextBlock FontSize="16" Foreground="#FFFFFFFF" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Shell.Settings, Converter={StaticResource DashboardTileTitleConverter}, ConverterParameter=home.sports|Sports}" />
            </Border>
          </Grid>
        </Button>
        <Button Canvas.Left="604" Canvas.Top="246" Width="160" Height="122" Style="{StaticResource X360TileButtonStyle}" Command="{Binding Shell.OpenYouTubeCommand}">
          <Grid Background="#FFFFFFFF" ClipToBounds="True">
            <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Shell.Settings, Converter={StaticResource DashboardTileImageSourceConverter}, ConverterParameter=home.youtube|Assets/Tiles/youtubehome.jpg|256}" />
            <Rectangle>
              <Shape.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#00000000" Offset="0.58" />
                  <GradientStop Color="#78000000" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
          </Grid>
        </Button>
      </Canvas>
      <StackPanel Canvas.Left="1115" Canvas.Top="11" Visibility="Collapsed">
        <Button Width="177" Height="122" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Friends" FontSize="17" Foreground="#FFFFFFFF" Margin="10,0,0,12" VerticalAlignment="Bottom" />
            <Path Fill="#DDFFFFFF" Stretch="Uniform" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M17,3 A7,7 0 1 1 16.9,3M7,34 C8,24 26,24 27,34 M30,8 A6,6 0 1 1 29.9,8M24,32 C25,25 39,25 40,32" />
          </Grid>
        </Button>
        <Button Width="177" Height="122" Margin="0,1,0,0" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Avatar" FontSize="17" Foreground="#FFFFFFFF" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
        <Button Width="177" Height="122" Margin="0,1,0,0" Style="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Sign In" FontSize="17" Foreground="#FFFFFFFF" Margin="10,0,0,12" VerticalAlignment="Bottom" />
          </Grid>
        </Button>
      </StackPanel>
    </Canvas>
  </Grid>
</UserControl>
